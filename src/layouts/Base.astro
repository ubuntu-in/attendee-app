---
/**
 * @file Base.astro
 * @description The core layout wrapper for the PWA. 
 * Provides the essential document structure, global navigation (Header), and Footer.
 * Configured strictly with Canonical Vanilla Framework.
 */
import '../styles/global.scss';
import NavBar from '../components/NavBar.astro';
import Footer from '../components/Footer.astro';

export interface Props {
  title: string;
}

const { title } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="icon" type="image/png" sizes="32x32" href={`${base}favicon-32x32.png`} />
    <link rel="icon" type="image/png" sizes="16x16" href={`${base}favicon-16x16.png`} />
    <link rel="icon" href={`${base}favicon.ico`} sizes="16x16 32x32" />
    <link rel="apple-touch-icon" sizes="180x180" href={`${base}apple-touch-icon.png`} />
    <link rel="manifest" href={`${base}manifest.webmanifest`} />
    <meta name="theme-color" content="#E95420" />
    <title>{title} | UbuCon India 2026</title>
  </head>
  <body>
    <NavBar />

    <!-- Main Content Area -->
    <main id="main-content">
      <slot />
    </main>

    <!-- Global Footer -->
    <Footer />
  </body>
</html>
