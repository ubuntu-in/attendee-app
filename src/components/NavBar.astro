---
const base = import.meta.env.BASE_URL;
const links = [
  { label: "Home", href: `${base}` },
  { label: "Ticket", href: `${base}ticket` },
  { label: "Schedule", href: `${base}schedule` },
  { label: "Venue", href: `${base}venue` },
];

const here = Astro.url.pathname.replace(/\/$/, "") || "/";

const isActive = (href: string) => {
  const target = href.replace(/\/$/, "") || "/";
  return here === target || here.startsWith(`${target}/`);
};
---

<style>
  .p-navigation__toggle--open .p-icon--menu,
  .p-navigation__toggle--close .p-icon--close {
    width: 1.5rem;
    height: 1.5rem;
  }
</style>

<header id="navigation" class="p-navigation is-dark is-sticky">
  <div class="p-navigation__row--25-75">
    <div class="p-navigation__banner">
      <div class="p-navigation__tagged-logo">
        <a class="p-navigation__link" href={`${base}`} aria-label="Attendee App home">
          <div class="p-navigation__logo-tag">
            <img class="p-navigation__logo-icon" src={`${base}ashoke-chakra-cof.svg`} alt="Ubuntu India"/>
          </div>
          <span class="p-navigation__logo-title">Attendee App</span>
        </a>
      </div>
      <ul class="p-navigation__items">
        <li class="p-navigation__item">
          <a class="p-navigation__toggle--open" href="#navigation" aria-label="Open menu">
            <i class="p-icon--menu"></i>
          </a>
          <a class="p-navigation__toggle--close" href="#" aria-label="Close menu">
            <i class="p-icon--close"></i>
          </a>
        </li>
      </ul>
    </div>
    <nav class="p-navigation__nav" aria-label="Main">
      <ul class="p-navigation__items">
        {
          links.map((l) => (
            <li
              class:list={[
                "p-navigation__item",
                { "is-selected": isActive(l.href) },
              ]}
            >
              <a
                class="p-navigation__link"
                href={l.href}
                aria-current={isActive(l.href) ? "page" : undefined}
              >
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>
