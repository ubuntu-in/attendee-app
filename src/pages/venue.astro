---
/**
 * @file venue.astro
 * @description The venue page for the UbuCon India 2026 Attendee App.
 */
import Base from '../layouts/Base.astro';

const venue = {
  name: 'BMS College of Engineering',
  address: 'Bull Temple Rd, Basavanagudi, Bengaluru, Karnataka 560004',
  city: 'Bengaluru, India',
  startDate: new Date('2026-11-14'),
  endDate: new Date('2026-11-15'),
  mapEmbed:
    'https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3888.4720098421913!2d77.56422961107282!3d12.941620315481376!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x3bae158b11e34d2f%3A0x5f4adbdbab8bd80f!2sBMS%20College%20of%20Engineering!5e0!3m2!1sen!2sin!4v1784802109426!5m2!1sen!2sin',
  gettingThere: [
    {
      title: 'By Metro',
      body: 'The nearest metro station is National College (Green Line), ~1.9 km away. A short auto ride or 15-minute walk will get you to campus.',
    },
    {
      title: 'By Air',
      body: 'Kempegowda International Airport (BLR) is ~40 km away. You can take a Vayu Vajra airport bus or a taxi directly to the venue.',
    },
    {
      title: 'By Train',
      body: 'KSR Bengaluru City Railway Station (Majestic) is ~5 km away. From there, you can switch to the Green Line metro or take a taxi.',
    },
  ],
};

const dateRange = `${venue.startDate.toLocaleDateString('en-IN', { day: 'numeric', month: 'long' })} \u2013 ${venue.endDate.toLocaleDateString('en-IN', { day: 'numeric', month: 'long', year: 'numeric' })}`;

const mapsUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(
  `${venue.name}, ${venue.city}`,
)}`;
---

<Base title="Venue">
  <div class="col-12">
    <h1 class="venue-title">Venue</h1>
    <p>
      Join us in {venue.city.replace(/,.*$/, '')} for two days of talks,
      workshops and community. Here&rsquo;s how to reach the venue.
    </p>
  </div>

  <div class="col-12">
    <div class="row u-no-padding">
      <div class="col-7 col-medium-6 col-small-4 venue-map-wrapper">
        <iframe
          src={venue.mapEmbed}
          title={`Map of ${venue.name}`}
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          allowfullscreen
          class="venue-map"
        />
      </div>

      <div class="col-5 col-medium-6 col-small-4 p-card venue-info-card">
        <h2 class="p-heading--4 venue-name">
          <svg
            viewBox="0 0 16 16"
            width="26"
            height="26"
            aria-hidden="true"
            class="venue-pin-icon"
          >
            <path d="M8 16s6-5.686 6-10A6 6 0 0 0 2 6c0 4.314 6 10 6 10zm0-7a3 3 0 1 1 0-6 3 3 0 0 1 0 6z" />
          </svg>
          {venue.name}
        </h2>
        <p class="u-text--muted">{venue.address}</p>
        <p class="venue-dates">{dateRange}</p>
        {/* Darker green for better contrast against the white card background;
            the global $color-positive (#38B44A) is lighter and intended for
            success badges / toasts, not primary CTA buttons. */}
        <a
          class="p-button--positive venue-directions-btn"
          href={mapsUrl}
          rel="noopener"
          target="_blank"
          role="button"
        >
          Get directions
        </a>
      </div>
    </div>
  </div>

  <div class="col-12">
    <h2 class="p-heading--4 venue-section-heading">Getting there</h2>
    <div class="p-accordion">
      {
        venue.gettingThere.map((g, i) => (
          <details class="p-accordion__group" open={i === 0}>
            <summary class="p-accordion__tab">{g.title}</summary>
            <section class="p-accordion__panel u-no-margin--bottom">
              <p>{g.body}</p>
            </section>
          </details>
        ))
      }
    </div>
  </div>
</Base>

<style>
  /* ── Page heading ───────────────────────────────────────────── */
  .venue-title {
    font-weight: 800;
  }

  /* ── Map / info-card row ────────────────────────────────────── */
  .venue-map-wrapper {
    min-height: 360px;
    background: var(--vf-color-background-alt, #f2f2f2);
    display: grid;
    place-items: center;
  }

  .venue-map {
    width: 100%;
    height: 100%;
    min-height: 360px;
    border: 0;
  }

  .venue-info-card {
    display: flex;
    flex-direction: column;
  }

  /* Aubergine — mirrors $color-primary in src/styles/global.scss */
  .venue-name {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--vf-color-primary, #772953);
  }

  /* Ubuntu orange pin icon */
  .venue-pin-icon {
    flex-shrink: 0;
    fill: var(--vf-color-accent, #e95420);
  }

  .venue-dates {
    color: var(--vf-color-accent, #e95420);
  }

  /* Darker green for better contrast on a white card;
     the global $color-positive (#38B44A) is lighter and meant for
     success badges / toasts, not primary CTA buttons. */
  .venue-directions-btn {
    margin-top: auto;
    text-align: center;
    --vf-color-button-positive-default: #0e8420;
    --vf-color-button-positive-hover: #0c701b;
    --vf-color-button-positive-active: #0a5c16;
  }

  /* ── Getting there section ──────────────────────────────────── */
  .venue-section-heading {
    font-weight: 700;
  }

  /* Vanilla styles .p-accordion__tab as a <button> with aria-expanded; on a
     native <details> the chevron has to be flipped from the open state. */
  details:not([open]) > .p-accordion__tab::before {
    transform: rotate(-90deg);
  }
</style>
