# Required environment variables for the UbuCon Attendee PWA.
# Copy this file to `.env` and fill in the values before running the dev server or building.
#
# IMPORTANT: Never commit your actual `.env` file — it is listed in .gitignore.

# The KonfHub event UUID for UbuCon India 2026.
# Used to validate tickets against the KonfHub API and to generate QR code payloads.
# Format: xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
PUBLIC_EVENT_ID=78cfc22a-ad61-471e-aadc-7dd798ff09a8

# The Indico event ID for UbuCon India 2026 (from events.canonical.com).
# Used to fetch the live event schedule from the Indico REST API.
# Update this value each year when a new UbuCon event is created on Indico.
PUBLIC_INDICO_EVENT_ID=157
